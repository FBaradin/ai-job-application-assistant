# Copy this file to ".env" (same folder) and fill in the values (see docs/GETTING_STARTED.md, part 5).
# .env is git-ignored: it never leaves your computer.
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Google Sheets job tracker (optional; see docs/GETTING_STARTED.md, part 6).
# Path to the service account JSON key (keep it inside secrets/, which is git-ignored).
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
# The long id in the sheet URL: https://docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=
